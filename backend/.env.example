# Copier ce fichier en .env et adapter les valeurs
APP_NAME=7360 API
# Origines autorisées pour le CORS (séparées par des virgules). "*" en dev uniquement.
CORS_ORIGINS=*
# SQLite en dev ; en prod par ex. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./app.db
# OBLIGATOIRE à changer en prod : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
